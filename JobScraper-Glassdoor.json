    {
      "Command": "pause",
      "Target": "500",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") a[class*='JobCard_jobTitle']\"); return el ? el.innerText.trim() : '';",
      "Value": "jobTitle",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el = document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") div[class*='JobCard_jobCardContent'] span\"); return el ? el.innerText.trim() : '';",
      "Value": "company",
      "Description": "Generic span extraction for Company Name"
    },
    {
      "Command": "executeScript",
      "Target": "var item = document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\")\"); if (!item) return ''; var ratingEl = item.querySelector(\"div[role='meter']\"); if (ratingEl) { return ratingEl.getAttribute('aria-label') || ratingEl.innerText.trim(); } var altRating = item.querySelector(\"svg path\"); if (altRating && altRating.closest('div')) { return altRating.closest('div').innerText.trim(); } return '';",
      "Value": "companyRating",
      "Description": "Fallback logic for Company Rating extraction"
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") div[class*='JobCard_location']\"); return el ? el.innerText.trim() : '';",
      "Value": "location",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") div[class*='JobCard_salaryEstimate']\"); return el ? el.innerText.trim() : '';",
      "Value": "pay",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") a[class*='JobCard_jobTitle']\"); return el ? el.href : '';",
      "Value": "url",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") div[class*='JobCard_easyApplyTag']\"); return el ? 'Easy Apply' : '';",
      "Value": "quickApply",
      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var el=document.querySelector(\"li[class*='JobsList_jobListItem']:nth-child(\"+${loopCounter}+\") div[class*='JobCard_listingAge']\"); return el ? el.innerText.trim() : '';",
      "Value": "postAge",
      "Description": ""
