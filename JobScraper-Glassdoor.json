      "Description": ""
    },
    {
      "Command": "executeScript",
      "Target": "var popup = document.querySelector('button[class*=\"modal_CloseButton\"], button[class*=\"CloseButton\"]'); if(popup) popup.click(); return true;",
      "Value": "",
      "Description": ""
    },
    {
      "Command": "click",
      "Target": "xpath=//li[${loopCounter}]/div/div/div/div/a[2]",
      "Value": "",
